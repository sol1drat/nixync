    "/login": {
      "post": {
        "tags": [
          "server"
        ],
        "summary": "Login",
        "description": "Check a single hardcoded operator account.\n\nThis MVP has no authorization: every other endpoint is open, and nothing checks a\nsession afterwards. The endpoint exists so the desktop app's sign-in screen fails\nhonestly \u2014 wrong password, or server unreachable \u2014 rather than waving everyone\nthrough locally. Issuing a token nothing verifies would only look like security.",
        "operationId": "login_login_post",
        "requestBody": {
          "content": {
